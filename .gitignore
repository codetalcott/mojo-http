# Mojo build artifacts
*.mojoc
*.mojopkg
*.o
*.so
*.dylib

# uv (uv.lock IS tracked — it pins the Mojo toolchain)
.venv/

# IDE — the example is tracked; real settings hold machine-absolute paths.
.vscode/*
!.vscode/settings.example.json
.idea/

# OS
.DS_Store

__pycache__/

# Compiled app binaries (rebuild with `mojo build`)
apps/hello/hello
# The serve CLI (rebuild with `uv run poe build-serve`)
bin/

# Every log at the repo root: CI's warning-ratchet input (compile.log), the
# server logs smokes, benches, probes and soak.py write beside the tree, and
# what a failing round of stress-asgi keeps for the next investigator. One
# pattern rather than a name per task, because the names went stale -- about
# thirty were missing, and `bench-mojo-mount` leaving an unignored log behind
# is what stamped its artifact `git_dirty: true`.
/*.log

# A wheel staged for the docs site's image probe (scripts/site_image_probe.py)
deploy/site/wheelhouse/*.whl

.venv-pinned/
probe.out
dist/
.sesskey

# Wheel build output. _bin/_lib/licenses under the packaging project are
# STAGED by `poe stage-wheel` from artifacts built elsewhere in the tree, so
# they are build output rather than sources. Hatchling excludes VCS-ignored
# files by default, which is why packaging/m0serve/pyproject.toml has to name
# them under `artifacts` -- see the comment there.
packaging/m0serve/src/m0serve/_bin/
packaging/m0serve/src/m0serve/_lib/
packaging/m0serve/src/m0serve/licenses/
packaging/m0serve/licenses/
packaging/m0serve/dist/

# Session state: worktrees are checkouts of this repo, handoffs are notes.
.claude/worktrees/
.claude/handoffs/
